<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Dev harness actions and extras are documented on CharacterReviewHarnessReceiver -->
        <receiver
            android:name="com.ilustris.sagai.debug.CharacterReviewHarnessReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ilustris.sagai.debug.REVIEW_CHARACTER" />
                <action android:name="com.ilustris.sagai.debug.GENERATE_CHARACTERS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
