<?xml version="1.0" encoding="utf-8"?><!--
   Backup / device-transfer rules for API 31+.
   https://developer.android.com/about/versions/12/backup-restore#xml-changes

   The BYOK key store is excluded from both paths: the encrypted blob would travel but the Android
   Keystore secret that unwraps it would not, leaving an undecryptable file on the target device.
   The app treats that as "no key" and asks for it again, which is exactly what we want to happen
   without shipping the ciphertext anywhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/byok_datastore.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/byok_datastore.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
