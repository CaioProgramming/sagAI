
uniform shader uMask;
uniform shader uS;
uniform shader uCol;
uniform float uTime;
uniform float uIntensity;
uniform float uHeight;
uniform float uTextY;
uniform float uTextH;
uniform float2 uRes;
uniform float3 uC1;
uniform float3 uC2;
uniform float3 uC3;
uniform float3 uC4;
uniform float3 uHalo;
uniform float3 uText;
uniform float3 uOpt;
uniform float uEvtA;
uniform float uEvtB;
uniform float uSeedB;
uniform float uSeedA;
uniform float uEntry;
uniform float uEntryDur;
uniform float2 uTx;
uniform float4 uBox;
uniform float4 uFw;
uniform float4 uTrail[8];
uniform float2 uTrailV[8];
uniform float4 uPtr;
uniform float4 uCut;
// recent finger positions with a fading strength; returns (influence, weighted velocity x, y)
float3 trailField(float2 uv, float asp, float rad){
  float3 acc = float3(0.);
  for (int i = 0; i < 8; i++){
    float2 d = (uv - uTrail[i].xy) * float2(asp, 1.);
    float g = exp(-dot(d, d) / (rad * rad)) * uTrail[i].z;
    acc.x += g; acc.yz += uTrailV[i] * g;
  }
  return acc;
}
uniform float2 uBoxCfg;
// Simulates the bounds a Compose layout gives the title: nothing may show outside the box.
// With the soft edge on, every effect fades to the background over the margin instead of being cut.
float boxMask(float2 uv){
  if (uBoxCfg.x < .5) return 1.;
  float2 px = uv * uRes, lo = uBox.xy * uRes, hi = uBox.zw * uRes;
  float soft = uBoxCfg.y;
  float fx = max(soft > .5 ? uFw.x : 1., 1.), ft = max(soft > .5 ? uFw.y : 1., 1.), fb = max(soft > .5 ? uFw.z : 1., 1.);
  float m = smoothstep(lo.x, lo.x + fx, px.x) * (1. - smoothstep(hi.x - fx, hi.x, px.x));
  return m * smoothstep(lo.y, lo.y + fb, px.y) * (1. - smoothstep(hi.y - ft, hi.y, px.y));
}
float3 boxed(float3 c, float2 uv){
  if (uBoxCfg.x < .5) return c;
  float2 px = uv * uRes, lo = uBox.xy * uRes, hi = uBox.zw * uRes;
  float soft = uBoxCfg.y;
  float fx = max(soft > .5 ? uFw.x : 1., 1.), ft = max(soft > .5 ? uFw.y : 1., 1.), fb = max(soft > .5 ? uFw.z : 1., 1.);
  float m = smoothstep(lo.x, lo.x + fx, px.x) * (1. - smoothstep(hi.x - fx, hi.x, px.x));
  m *= smoothstep(lo.y, lo.y + fb, px.y) * (1. - smoothstep(hi.y - ft, hi.y, px.y));
  float3 o = mix(float3(0.), c, m);
  float2 d = min(px - lo, hi - px);
  float e = min(d.x, d.y);
  o = mix(o, float3(.35, .75, 1.), (1. - smoothstep(0., 1.6, abs(e))) * .7 * step(-1.6, e) * step(.5, uFw.w));
  return o;
}
float hash(float2 p){ p = fract(p * float2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
float noise(float2 p){ float2 i = floor(p), f = fract(p); f = f * f * (3. - 2. * f);
  float a = hash(i), b = hash(i + float2(1., 0.)), c = hash(i + float2(0., 1.)), d = hash(i + float2(1., 1.));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y); }
float fbm(float2 p){ float v = 0., a = .5; for (int i = 0; i < 4; i++){ v += a * noise(p); p = p * 2.03 + float2(7.1, 3.7); a *= .5; } return v; }

// Child shaders are sampled in pixel space; the lab sampled normalised uv with y up.
half4 sM(float2 p) { return uMask.eval(float2(p.x * uRes.x, (1.0 - p.y) * uRes.y)); }
half4 sS(float2 p) { return uS.eval(float2(p.x * uRes.x, (1.0 - p.y) * uRes.y)); }
half4 sC(float2 p) { return uCol.eval(float2(p.x * uRes.x, (1.0 - p.y) * uRes.y)); }
// Emissive output: the effect is light on a transparent layer. A pixel is as opaque as it is bright,
// or as covered by the letters, so nothing paints a backdrop and gradientFill/shimmer find no box.
half4 finish(float3 c, float cov) {
    c = clamp(c, 0.0, 1.0);
    float a = clamp(max(max(c.r, max(c.g, c.b)), cov), 0.0, 1.0);
    return half4(half3(c), half(a));
}

half4 main(float2 fragCoord){
  float2 uv = float2(fragCoord.x / uRes.x, 1.0 - fragCoord.y / uRes.y);
  float asp = uRes.x / uRes.y; float t = uTime;
  float tick = floor(t * 9.);
  float gl = step(.93, hash(float2(tick, 1.3)));
  float yc = uTextY + (hash(float2(tick, 2.7)) - .5) * uTextH * 1.2;
  float bh = uTextH * (.12 + .3 * hash(float2(tick, 4.1)));
  float inBand = gl * (1. - smoothstep(bh, bh * 1.4, abs(uv.y - yc)));
  float tear = (hash(float2(tick, 5.5)) - .5) * .07 * inBand;
  float2 mu = uv + float2(tear, 0.);
  float cs = .004 + .006 * gl;
  float4 cR = sC( mu + float2(cs, 0.));
  float4 cG = sC( mu);
  float4 cB = sC( mu - float2(cs, 0.));
  float sh = sM( uv - float2(.004 / asp, -.007)).r;
  float4 S = sS( uv);
  float3 outc = float3(0.) + uHalo * S.b * .18;
  outc = mix(outc, float3(0.), sh * .65);
  outc = float3(mix(outc.r, cR.r, cR.a), mix(outc.g, cG.g, cG.a), mix(outc.b, cB.b, cB.a));
  float gr = hash(floor(uv * uRes * .5) + floor(t * 6.));
  outc *= 1. - cG.a * .22 * gr;
  outc += (hash(uv * uRes + fract(t) * 91.7) - .5) * ((.07 + .4 * inBand)) * smoothstep(0., .06, max(outc.r, max(outc.g, outc.b)));
  float fxCov = (max(max(cG.a, cR.a), cB.a)) * boxMask(uv);
  return finish(boxed(outc, uv), fxCov);
}