// Chromatic fringe for the share collector cards.
//
// Splits the red and blue channels sideways by an amount that follows the card's tilt, so edges pick
// up a thin prismatic halo that swings with the card. A filter, not a generator: it is bound as a
// RenderEffect and samples the layer it is applied to. Three taps per pixel, so it can run on every
// frame, unlike the genre filter shader, which is why this does not reuse that shader's own
// chromatic aberration (that one is a fixed value from the genre config, applied once and baked).

uniform shader image;

// Offset of the red channel in pixels; blue moves the opposite way.
uniform float2 u_shift;

half4 main(float2 fragCoord) {
    half4 centre = image.eval(fragCoord);
    half red = image.eval(fragCoord + u_shift).r;
    half blue = image.eval(fragCoord - u_shift).b;
    return half4(red, centre.g, blue, centre.a);
}
