<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF0A0C0F" android:endColor="#FF1A1F2A" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:width="86dp" android:height="9dp" android:gravity="start|center_vertical" android:start="18dp" android:bottom="14dp">
        <shape android:shape="rectangle"><solid android:color="#E6FFFFFF" /><corners android:radius="5dp" /></shape>
    </item>
    <item android:width="58dp" android:height="9dp" android:gravity="start|center_vertical" android:start="18dp" android:top="16dp">
        <shape android:shape="rectangle"><solid android:color="#99FFFFFF" /><corners android:radius="5dp" /></shape>
    </item>
    <item android:width="30dp" android:height="30dp" android:gravity="end|center_vertical" android:end="18dp">
        <shape android:shape="oval"><solid android:color="#FFFFD166" /></shape>
    </item>
</layer-list>
