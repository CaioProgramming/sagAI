uniform shader composable_shader;
uniform float2 iResolution;
uniform float u_aspectRatio;

// Grain
uniform float u_grainIntensity;

// Bloom
uniform float u_bloomThreshold;
uniform float u_bloomIntensity;
uniform float u_bloomRadius;

// Soft Focus (legacy — keep 0 in presets)
uniform float u_softFocusRadius;

// Color Grading
uniform float u_saturation;
uniform float u_contrast;
uniform float u_brightness;
uniform vec3 u_highlightTint;
uniform vec3 u_shadowTint;
uniform float u_tintStrength;

// Vignette
uniform float u_vignetteStrength;
uniform float u_vignetteSoftness;

// Pixelation
uniform float u_pixelationBlockSize;

// Color Temperature
uniform float u_colorTemperature;

// Tone curve
uniform float u_blackPoint;
uniform float u_whitePoint;

// New cheap effects
uniform float u_chromaticAberration;
uniform float u_scanlineIntensity;
uniform float u_scanlineDensity;
uniform float u_posterizeLevels;
uniform float u_halftoneScale;
uniform float u_sharpenAmount;

// Ultimate-style rim energy (Overwatch HUD aura)
uniform float iTime;
uniform float u_rimEnergyIntensity;
uniform vec3 u_rimEnergyColor;
uniform vec3 u_rimEnergyOuterColor;
uniform float u_rimEnergyWidth;
uniform float u_wispIntensity;
uniform float u_wispSpeed;

// Selective highlight (optional pass)
uniform float u_selectiveHighlightEnabled;
uniform vec3 u_targetHighlightColorRGB;
uniform float u_hueTolerance;
uniform float u_saturationThreshold;
uniform float u_lightnessThreshold;
uniform float u_highlightSaturationBoost;
uniform float u_highlightLightnessBoost;
uniform float u_desaturationFactorNonTarget;

const int KERNEL_RADIUS = 3;

float random(vec2 st) {
    return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453);
}

float getLuminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

vec3 fastBlur(float2 uv_pixel_space, float radius) {
    if (radius <= 0.1) return composable_shader.eval(uv_pixel_space).rgb;

    vec3 sum = vec3(0.0);
    float weight = 0.0;
    float step = max(1.0, radius / float(KERNEL_RADIUS));

    for (int y = -KERNEL_RADIUS; y <= KERNEL_RADIUS; ++y) {
        for (int x = -KERNEL_RADIUS; x <= KERNEL_RADIUS; ++x) {
            float2 offset = vec2(float(x), float(y)) * step;
            sum += composable_shader.eval(uv_pixel_space + offset).rgb;
            weight += 1.0;
        }
    }
    return sum / weight;
}

vec3 bloomBlur(float2 uv_pixel_space, float radius, float threshold) {
    if (radius <= 0.1) return vec3(0.0);

    vec3 sum = vec3(0.0);
    float weight = 0.0;
    float step = max(1.0, radius / float(KERNEL_RADIUS));

    for (int y = -KERNEL_RADIUS; y <= KERNEL_RADIUS; ++y) {
        for (int x = -KERNEL_RADIUS; x <= KERNEL_RADIUS; ++x) {
            float2 offset = vec2(float(x), float(y)) * step;
            vec3 col = composable_shader.eval(uv_pixel_space + offset).rgb;
            float luma = getLuminance(col);
            if (luma > threshold) {
                sum += col * (luma - threshold);
            }
            weight += 1.0;
        }
    }
    return sum / weight;
}

// --- HSL helpers (selective highlight) ---

vec3 rgbToHsl(vec3 color) {
    float r = color.r;
    float g = color.g;
    float b = color.b;

    float maxVal = max(max(r, g), b);
    float minVal = min(min(r, g), b);
    float delta = maxVal - minVal;

    float h = 0.0;
    float s = 0.0;
    float l = (maxVal + minVal) / 2.0;

    if (delta > 0.00001) {
        s = (l < 0.5) ? (delta / (maxVal + minVal)) : (delta / (2.0 - maxVal - minVal));
        if (r == maxVal) {
            h = (g - b) / delta;
        } else if (g == maxVal) {
            h = 2.0 + (b - r) / delta;
        } else {
            h = 4.0 + (r - g) / delta;
        }
        h /= 6.0;
        if (h < 0.0) h += 1.0;
    }
    return vec3(h, s, l);
}

float hueToRgbComponent(float p, float q, float t) {
    if (t < 0.0) t += 1.0;
    if (t > 1.0) t -= 1.0;
    if (t < 1.0 / 6.0) return p + (q - p) * 6.0 * t;
    if (t < 1.0 / 2.0) return q;
    if (t < 2.0 / 3.0) return p + (q - p) * (2.0 / 3.0 - t) * 6.0;
    return p;
}

vec3 hslToRgb(vec3 hsl) {
    float h = hsl.x;
    float s = hsl.y;
    float l = hsl.z;

    if (s == 0.0) {
        return vec3(l);
    }
    float q = (l < 0.5) ? (l * (1.0 + s)) : (l + s - l * s);
    float p = 2.0 * l - q;
    float r = hueToRgbComponent(p, q, h + 1.0 / 3.0);
    float g = hueToRgbComponent(p, q, h);
    float b = hueToRgbComponent(p, q, h - 1.0 / 3.0);
    return vec3(r, g, b);
}

float hueDistance(float hue1, float hue2) {
    float d = abs(hue1 - hue2);
    return min(d, 1.0 - d);
}

vec3 applySelectiveHighlight(vec3 colorRGB) {
    vec3 targetHsl = rgbToHsl(u_targetHighlightColorRGB);
    vec3 currentHsl = rgbToHsl(colorRGB);

    bool isTargetColor = false;
    if (currentHsl.y >= u_saturationThreshold && currentHsl.z >= u_lightnessThreshold) {
        if (hueDistance(currentHsl.x, targetHsl.x) <= u_hueTolerance) {
            isTargetColor = true;
        }
    }

    if (isTargetColor) {
        currentHsl.y = min(1.0, currentHsl.y * u_highlightSaturationBoost);
        currentHsl.z = clamp(currentHsl.z + u_highlightLightnessBoost, 0.0, 1.0);
        return hslToRgb(currentHsl);
    }
    currentHsl.y *= u_desaturationFactorNonTarget;
    return hslToRgb(currentHsl);
}

vec3 applyToneCurve(vec3 color) {
    float range = max(u_whitePoint - u_blackPoint, 0.001);
    return clamp((color - u_blackPoint) / range, 0.0, 1.0);
}

vec3 applyPosterize(vec3 color) {
    if (u_posterizeLevels < 2.0) return color;
    float levels = floor(u_posterizeLevels);
    return floor(color * levels + 0.5) / levels;
}

vec3 applyHalftone(vec3 color, vec2 fragCoord, float alpha) {
    if (u_halftoneScale < 1.0) return color;
    float luma = getLuminance(color);
    vec2 cell = mod(fragCoord / u_halftoneScale, 1.0) - 0.5;
    float d = length(cell);
    float dotMask = smoothstep(0.5, 0.42, d * (1.1 - luma));
    return mix(color * 0.85, color, dotMask * alpha + (1.0 - alpha));
}

vec3 applySharpen(vec3 color, float2 fragCoord, float alpha) {
    if (u_sharpenAmount <= 0.001) return color;
    vec3 neighbors =
        composable_shader.eval(fragCoord + float2(-1.0, 0.0)).rgb +
        composable_shader.eval(fragCoord + float2(1.0, 0.0)).rgb +
        composable_shader.eval(fragCoord + float2(0.0, -1.0)).rgb +
        composable_shader.eval(fragCoord + float2(0.0, 1.0)).rgb;
    vec3 blur = neighbors * 0.25;
    return color + (color - blur) * u_sharpenAmount * alpha;
}

vec3 applyChromatic(vec3 color, float2 fragCoord, float alpha) {
    if (u_chromaticAberration <= 0.0001) return color;
    float2 offset = float2(u_chromaticAberration * iResolution.x, 0.0);
    float r = composable_shader.eval(fragCoord + offset).r;
    float b = composable_shader.eval(fragCoord - offset).b;
    return vec3(
        mix(color.r, r, alpha),
        color.g,
        mix(color.b, b, alpha)
    );
}

float sampleAlpha(float2 fragCoord) {
    return composable_shader.eval(fragCoord).a;
}

// Rim glow + outer energy wisps hugging the content silhouette (OW ultimate-style)
vec4 applyRimEnergy(vec3 color, float2 fragCoord, float centerAlpha) {
    if (u_rimEnergyIntensity <= 0.001) {
        return vec4(color, centerAlpha);
    }

    float width = max(u_rimEnergyWidth, 1.0);

    float gx = sampleAlpha(fragCoord + float2(1.0, 0.0)) - sampleAlpha(fragCoord + float2(-1.0, 0.0));
    float gy = sampleAlpha(fragCoord + float2(0.0, 1.0)) - sampleAlpha(fragCoord + float2(0.0, -1.0));
    float edge = clamp(length(float2(gx, gy)) * 4.0, 0.0, 1.0);

    float pulse = 0.7 + 0.3 * sin(iTime * max(u_wispSpeed, 0.1) * 2.5);
    edge *= pulse;

    vec2 uv = fragCoord / iResolution;
    vec2 toCenter = uv - 0.5;
    toCenter.x *= u_aspectRatio;
    float angle = atan(toCenter.y, toCenter.x);

    float maxNeighbor = 0.0;
    for (int i = 0; i < 8; i++) {
        float ang = float(i) * 0.785398163;
        float2 off = vec2(cos(ang), sin(ang)) * width;
        maxNeighbor = max(maxNeighbor, sampleAlpha(fragCoord + off));
    }

    float wispA = sin(angle * 5.0 + iTime * u_wispSpeed) * 0.5 + 0.5;
    float wispB = sin(angle * 9.0 - iTime * u_wispSpeed * 0.85) * 0.5 + 0.5;
    float wispNoise = pow(wispA * wispB, 1.4);

    float outsideMask = 1.0 - smoothstep(0.0, 0.35, centerAlpha);
    float outerWisp = outsideMask * maxNeighbor * wispNoise * u_wispIntensity;

    float dist = length(toCenter);
    float ringRadius = 0.38 + sin(iTime * u_wispSpeed * 0.4) * 0.015;
    float hudRing = smoothstep(0.025, 0.0, abs(dist - ringRadius)) * 0.12 * u_wispIntensity;

    vec3 rimCore = mix(u_rimEnergyColor, vec3(1.0), edge * 0.55);
    vec3 energy = rimCore * edge * u_rimEnergyIntensity;
    energy += u_rimEnergyOuterColor * outerWisp * u_rimEnergyIntensity;
    energy += u_rimEnergyColor * hudRing * outsideMask;

    float glowAlpha = clamp(
        max(edge * 0.9, max(outerWisp * 0.75, hudRing)) * u_rimEnergyIntensity,
        0.0,
        1.0
    );

    return vec4(color + energy, max(centerAlpha, glowAlpha));
}

half4 main(float2 fragCoord) {
    vec2 uv = fragCoord.xy / iResolution.xy;
    float2 effectiveFragCoord = fragCoord;

    if (u_pixelationBlockSize >= 1.0) {
        effectiveFragCoord = (floor(fragCoord / u_pixelationBlockSize) + 0.5) * u_pixelationBlockSize;
    }

    half4 originalSample = composable_shader.eval(effectiveFragCoord);
    vec3 color;

    if (u_softFocusRadius > 0.1) {
        color = fastBlur(effectiveFragCoord, u_softFocusRadius);
    } else {
        color = originalSample.rgb;
    }

    float alpha = originalSample.a;

    if (abs(u_saturation - 1.0) > 0.01) {
        color = mix(vec3(getLuminance(color)), color, u_saturation);
    }

    if (abs(u_contrast - 1.0) > 0.01) {
        color = (color - 0.5) * u_contrast + 0.5;
    }

    color += u_brightness * alpha;

    if (abs(u_colorTemperature) > 0.01) {
        float temp = u_colorTemperature * 0.1 * alpha;
        color.r = clamp(color.r + temp, 0.0, 1.0);
        color.b = clamp(color.b - temp, 0.0, 1.0);
    }

    if (u_blackPoint > 0.001 || u_whitePoint < 0.999) {
        color = applyToneCurve(color);
    }

    color = applyPosterize(color);

    if (u_selectiveHighlightEnabled > 0.5) {
        color = applySelectiveHighlight(color);
    }

    if (u_bloomIntensity > 0.01) {
        color += bloomBlur(effectiveFragCoord, u_bloomRadius, u_bloomThreshold) * u_bloomIntensity * alpha;
    }

    if (u_tintStrength > 0.01) {
        float luma = getLuminance(color);
        vec3 shadow = mix(color, color * u_shadowTint, 1.0 - smoothstep(0.2, 0.5, luma));
        vec3 highlight = mix(shadow, shadow * u_highlightTint, smoothstep(0.5, 0.8, luma));
        color = mix(color, highlight, u_tintStrength);
    }

    color = applyHalftone(color, effectiveFragCoord, alpha);

    if (u_grainIntensity > 0.001) {
        color += (random(uv) - 0.5) * u_grainIntensity * alpha;
    }

    if (u_vignetteStrength > 0.001) {
        vec2 centeredUV = uv - 0.5;
        centeredUV.x *= u_aspectRatio;
        float dist = length(centeredUV);
        float vignette = smoothstep(0.2, u_vignetteSoftness + 0.2, dist);
        color *= (1.0 - vignette * u_vignetteStrength);
    }

    if (u_scanlineIntensity > 0.001) {
        float density = max(u_scanlineDensity, 1.0);
        float scan = sin(uv.y * iResolution.y / density * 3.14159) * 0.5 + 0.5;
        color *= 1.0 - u_scanlineIntensity * scan * alpha;
    }

    color = applySharpen(color, effectiveFragCoord, alpha);
    color = applyChromatic(color, effectiveFragCoord, alpha);

    vec4 rimResult = applyRimEnergy(color, effectiveFragCoord, alpha);
    color = clamp(rimResult.rgb, 0.0, 1.0);
    float outAlpha = clamp(rimResult.a, 0.0, 1.0);

    if (outAlpha < 0.001) {
        return half4(0.0);
    }
    return half4(color, outAlpha);
}
