<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices below API 31. See data_extraction_rules.xml for API 31+.
   https://developer.android.com/guide/topics/data/autobackup

   The BYOK key store is excluded on purpose: the encrypted blob lives here but the Android
   Keystore secret that unwraps it never leaves the device, so a restored copy is undecryptable
   dead weight. Better to ask for the key again than to ship garbage to a new device.
-->
<full-backup-content>
    <exclude
        domain="file"
        path="datastore/byok_datastore.preferences_pb" />
</full-backup-content>
