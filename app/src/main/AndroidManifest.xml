<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Audio Recording Permission (Cache only) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />


    <application
        android:name=".SagaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_dragon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_dragon"
        android:supportsRtl="true"
        android:theme="@style/Theme.SagAI"
        tools:targetApi="36">

        <!-- Disable default WorkManager initialization to use HiltWorkerFactory -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ilustris.sagai.fileprovider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
              android:resource="@xml/filepaths" />
        </provider>

        <activity
            android:name=".features.sos.ui.SOSActivity"
            android:exported="false"
            android:process=":sos"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SagAI" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.App.Starting" />

        <!--
            Launcher icons. MainActivity is never the launcher entry itself: exactly one of these aliases
            is enabled at a time (see AppIconManager). DefaultIcon is the one enabled in the manifest.
        -->
        <activity-alias
            android:name=".launcher.DefaultIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_dragon"
            android:roundIcon="@drawable/ic_dragon"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.FantasyIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_dragon_fantasy"
            android:roundIcon="@drawable/ic_dragon_fantasy"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.CyberpunkIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_dragon_cyberpunk"
            android:roundIcon="@drawable/ic_dragon_cyberpunk"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.HorrorIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_dragon_horror"
            android:roundIcon="@drawable/ic_dragon_horror"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.HeroesIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_dragon_heroes"
            android:roundIcon="@drawable/ic_dragon_heroes"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.CrimeIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_dragon_crime"
            android:roundIcon="@drawable/ic_dragon_crime"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.ShinobiIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_dragon_shinobi"
            android:roundIcon="@drawable/ic_dragon_shinobi"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.SpaceOperaIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_dragon_space_opera"
            android:roundIcon="@drawable/ic_dragon_space_opera"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.CowboyIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_dragon_cowboy"
            android:roundIcon="@drawable/ic_dragon_cowboy"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.PunkRockIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_dragon_punk_rock"
            android:roundIcon="@drawable/ic_dragon_punk_rock"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <service
            android:name=".core.media.SagaPlaybackService"
            android:exported="false" />

        <service
            android:name=".features.audiobook.player.BookAudioPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".core.notifications.ScheduledNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ilustris.sagai.SCHEDULED_NOTIFICATION" />
            </intent-filter>
        </receiver>


    </application>

</manifest>