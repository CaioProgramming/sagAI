
uniform shader uMask;
uniform shader uS;
uniform float uTime;
uniform float uIntensity;
uniform float uHeight;
uniform float uTextY;
uniform float uTextH;
uniform float2 uRes;
uniform float3 uC1;
uniform float3 uC2;
uniform float3 uC3;
uniform float3 uC4;
uniform float3 uHalo;
uniform float3 uText;
uniform float3 uOpt;
uniform float uEvtA;
uniform float uEvtB;
uniform float uSeedB;
uniform float uSeedA;
uniform float uEntry;
uniform float uEntryDur;
uniform float2 uTx;
uniform float4 uBox;
uniform float4 uFw;
uniform float4 uTrail[8];
uniform float2 uTrailV[8];
uniform float4 uPtr;
uniform float4 uCut;
// recent finger positions with a fading strength; returns (influence, weighted velocity x, y)
float3 trailField(float2 uv, float asp, float rad){
  float3 acc = float3(0.);
  for (int i = 0; i < 8; i++){
    float2 d = (uv - uTrail[i].xy) * float2(asp, 1.);
    float g = exp(-dot(d, d) / (rad * rad)) * uTrail[i].z;
    acc.x += g; acc.yz += uTrailV[i] * g;
  }
  return acc;
}
uniform float2 uBoxCfg;
// Simulates the bounds a Compose layout gives the title: nothing may show outside the box.
// With the soft edge on, every effect fades to the background over the margin instead of being cut.
float boxMask(float2 uv){
  if (uBoxCfg.x < .5) return 1.;
  float2 px = uv * uRes, lo = uBox.xy * uRes, hi = uBox.zw * uRes;
  float soft = uBoxCfg.y;
  float fx = max(soft > .5 ? uFw.x : 1., 1.), ft = max(soft > .5 ? uFw.y : 1., 1.), fb = max(soft > .5 ? uFw.z : 1., 1.);
  float m = smoothstep(lo.x, lo.x + fx, px.x) * (1. - smoothstep(hi.x - fx, hi.x, px.x));
  return m * smoothstep(lo.y, lo.y + fb, px.y) * (1. - smoothstep(hi.y - ft, hi.y, px.y));
}
float3 boxed(float3 c, float2 uv){
  if (uBoxCfg.x < .5) return c;
  float2 px = uv * uRes, lo = uBox.xy * uRes, hi = uBox.zw * uRes;
  float soft = uBoxCfg.y;
  float fx = max(soft > .5 ? uFw.x : 1., 1.), ft = max(soft > .5 ? uFw.y : 1., 1.), fb = max(soft > .5 ? uFw.z : 1., 1.);
  float m = smoothstep(lo.x, lo.x + fx, px.x) * (1. - smoothstep(hi.x - fx, hi.x, px.x));
  m *= smoothstep(lo.y, lo.y + fb, px.y) * (1. - smoothstep(hi.y - ft, hi.y, px.y));
  float3 o = mix(float3(0.), c, m);
  float2 d = min(px - lo, hi - px);
  float e = min(d.x, d.y);
  o = mix(o, float3(.35, .75, 1.), (1. - smoothstep(0., 1.6, abs(e))) * .7 * step(-1.6, e) * step(.5, uFw.w));
  return o;
}
float hash(float2 p){ p = fract(p * float2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
float noise(float2 p){ float2 i = floor(p), f = fract(p); f = f * f * (3. - 2. * f);
  float a = hash(i), b = hash(i + float2(1., 0.)), c = hash(i + float2(0., 1.)), d = hash(i + float2(1., 1.));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y); }
float fbm(float2 p){ float v = 0., a = .5; for (int i = 0; i < 4; i++){ v += a * noise(p); p = p * 2.03 + float2(7.1, 3.7); a *= .5; } return v; }

// Child shaders are sampled in pixel space; the lab sampled normalised uv with y up.
half4 sM(float2 p) { return uMask.eval(float2(p.x * uRes.x, (1.0 - p.y) * uRes.y)); }
half4 sS(float2 p) { return uS.eval(float2(p.x * uRes.x, (1.0 - p.y) * uRes.y)); }
// Emissive output: the effect is light on a transparent layer. A pixel is as opaque as it is bright,
// or as covered by the letters, so nothing paints a backdrop and gradientFill/shimmer find no box.
half4 finish(float3 c, float cov) {
    c = clamp(c, 0.0, 1.0);
    float a = clamp(max(max(c.r, max(c.g, c.b)), cov), 0.0, 1.0);
    return half4(half3(c), half(a));
}

float wedges(float2 pa, float seed){
  float ang = atan(pa.y, pa.x);
  float r = length(pa);
  float v = .8 * noise(float2(ang * 7., seed)) + .3 * noise(float2(ang * 34. + 3., seed * 1.7));
  return smoothstep(.6, .62, v) * smoothstep(.06, .2, r);
}
float2 trailBlade(float2 uv, float asp){
  float core = 0., glow = 0.;
  for (int i = 0; i < 7; i++){
    float4 a = uTrail[i], b = uTrail[i + 1];
    float str = min(a.z, b.z);
    float2 pa = (uv - a.xy) * float2(asp, 1.);
    float2 ba = (b.xy - a.xy) * float2(asp, 1.);
    float hh = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0., 1.);
    float d = length(pa - ba * hh);
    float w = (.003 + .010 * (1. - float(i) / 7.)) * str;
    float on = step(.03, str);
    core = max(core, (1. - smoothstep(w * .5, w, d)) * on);
    glow = max(glow, exp(-d / (w * 5. + .002)) * str * on);
  }
  return float2(core, glow);
}
half4 main(float2 fragCoord){
  float2 uv = float2(fragCoord.x / uRes.x, 1.0 - fragCoord.y / uRes.y);
  float asp = uRes.x / uRes.y; float t = uTime;
  float ent = uEntry, wd = max(uEntryDur, .01);
  float ign = smoothstep(wd, wd + 1.2, ent);
  float tx = clamp((uv.x - uTx.x) / max(uTx.y - uTx.x, .01), 0., 1.);
  float pen = clamp(ent / wd, 0., 1.);
  float tp = ent - tx * wd;
  float written = smoothstep(0., .05, tp);
  float filled = smoothstep(.15, .7, tp);

  float g = clamp((uv.y - (uTextY - uTextH * .5)) / uTextH, 0., 1.);
  float top = uTextY + uTextH * .5;
  float2 ctrS = float2(.5, uTextY);
  float2 pa = (uv - ctrS) * float2(asp, 1.);

  // katana: every cut is random (angle, place, side it starts from) and sometimes comes as 2 or 3 in a row.
  // Each cut opens a slit of negative along its path while the halves slide apart.
  float cnt = 1.;
  float L = asp * .65;
  float2 mu = uv;
  float inBand = 0., edge = 0., blade = 0., wgs = 0., side = 1., flashL = 0., scar = 0.;
  for (int i = 0; i < 3; i++){
    float fi = float(i);
    float sd = uSeedA * 13.7 + fi * 5.3;
    float on = step(fi, cnt - .5) * uOpt.y;
    float tci = uEvtA - .55 - fi * .11 - hash(float2(sd, 6.)) * .05;
    float cutOn = on * step(0., tci);
    float ang = (.12 + .5 * hash(float2(sd, 1.))) * (hash(float2(sd, 2.)) > .5 ? 1. : -1.);
    float2 dirR = float2(cos(ang), sin(ang));
    if (hash(float2(sd, 5.)) > .5) dirR = -dirR;
    float2 offR = float2(0., (hash(float2(sd, 4.)) - .5) * uTextH * 1.1);
    // a drag by the user replaces the random cut: same direction, same place
    float userOn = step(.5, uCut.w);
    float2 dirS = mix(dirR, float2(cos(uCut.z), sin(uCut.z)), userOn);
    float2 nS = float2(-dirS.y, dirS.x);
    float2 off = mix(offR, (uCut.xy - ctrS) * float2(asp, 1.), userOn);
    float2 pq = pa - off;
    float dc = dot(pq, nS), uc = dot(pq, dirS);
    float prog = clamp(tci / .12, 0., 1.);
    float vis = step(uc, -L + 2. * L * prog) * step(-L, uc);
    float taper = smoothstep(-L, -L * .85, uc) * (1. - smoothstep(L * .85, L, uc));
    float w = .005 + .008 * (1. - exp(-max(tci, 0.) * 30.));
    blade = max(blade, (1. - smoothstep(w * .4, w, abs(dc))) * vis * taper * exp(-max(tci, 0.) * 5.) * cutOn);
    // the halves open like scissors (wider in the middle); the negative is exactly the gap between them
    float lens = clamp(1. - pow(abs(uc) / L, 3.), 0., 1.);
    float sep = .03 * (1. - exp(-max(tci, 0.) * 22.)) * exp(-max(tci - .30, 0.) * 3.2) * cutOn * lens;
    float sgn = dc >= 0. ? 1. : -1.;
    mu -= nS / float2(asp, 1.) * sep * sgn;
    side *= step(0., sgn * dot((mu - ctrS) * float2(asp, 1.) - off, nS)) + (1. - cutOn);
    float bw = sep * 1.1;
    flashL = max(flashL, exp(-abs(dc) / .011) * vis * taper * exp(-max(tci, 0.) * 28.) * cutOn);
    scar = max(scar, (1. - smoothstep(.0012, .0035, abs(dc))) * taper * step(-L, uc) * step(uc, L) * smoothstep(.18, .4, tci) * exp(-max(tci - .4, 0.) * 1.6) * cutOn);
    float dcr = dc + (fbm(float2(uc * 14., 4. + sd)) - .5) * bw * .7;
    float brush = noise(float2(uc * 3., dc * 90.));
    float ib = (1. - smoothstep(bw - .004, bw + .004, abs(dcr) + brush * bw * .18)) * step(.003, bw) * vis;
    inBand = max(inBand, ib);
    edge = max(edge, exp(-pow((abs(dcr) - bw) / .007, 2.)) * step(.003, bw) * vis);
    wgs = max(wgs, wedges(pq, sd) * ib);
  }
  float tc0 = uEvtA - .55;
  mu.x += (noise(float2(floor(max(tc0, 0.) * 40.), 3.)) - .5) * .008 * exp(-max(tc0, 0.) * 9.) * step(0., tc0) * uOpt.y;
  // handwriting in white ink (outline first, fill behind the pen), like the crime title
  float m0r = sM( mu).r * min(side, 1.);
  float m0 = mix(m0r * (1. - smoothstep(.5, .9, sS( uv).b)), m0r, filled) * written;

  float4 S = sS( uv);
  float3 tf = trailField(uv, asp, .15);
  // no backdrop: only the text, the smoke and the cut
  float3 outc = float3(0.);

  // subtle smoke: a few thin wisps and soft puffs, same recipe as the cowboy mark
  float sc = uHeight / .85;
  float2 su = float2(uv.x, uTextY + max(uv.y - uTextY, 0.) / sc + min(uv.y - uTextY, 0.));
  float4 Sw = sS( su);
  float wx = uv.x * asp * 15.;
  float cell = floor(wx);
  float live = max(step(.5, hash(float2(cell, 3.7))), step(.15, tf.x));
  float ph = hash(float2(cell, 1.9)) * 6.28;
  float d = (uv.y - top) / (uTextH * 1.6 * sc);
  float sway = sin(d * 7. + t * 1.6 + ph) * .28 + (noise(float2(cell * 1.3, d * 3. - t * .5)) - .5) * .5;
  float xl = fract(wx) - .5 - sway * smoothstep(0., .3, d) - tf.y * .35;
  float thin = exp(-pow(xl / (.10 + .10 * d), 2.));
  float prof = smoothstep(-.02, .06, d) * (1. - smoothstep(.15, 1., d));
  float flow = .35 + .65 * noise(float2(cell * 2.1, d * 4. - t * .9));
  float smokeAmt = (.4 + .08 * sin(t * .6)) * uOpt.x * (1. + tf.x * .9) * ign;
  float wa = thin * live * prof * flow * smoothstep(.03, .2, Sw.r) * smokeAmt * .85;
  float pn = fbm(float2(uv.x * asp * 6. - tf.y * .5, uv.y * 5. - t * .8 - tf.z * .5));
  float puff = smoothstep(.55, .8, pn) * clamp(Sw.g * 2.2 + tf.x * .5, 0., 1.) * (1. - m0) * smokeAmt * .7;
  outc = mix(outc, float3(.62, .56, .52), max(wa, puff));

  float tcol0 = g;
  outc = mix(outc, mix(float3(1.), mix(uText * .8, uText, tcol0), ign), m0);

  // inside a slit the world is a negative: white paper, black ink, speed lines from the cut
  float3 neg = mix(float3(1., .97, .97), float3(.02, .015, .02), max(wgs, m0));
  outc = mix(outc, neg, inBand);
  float2 tbl = trailBlade(uv, asp);
  outc += float3(1.) * tbl.x + uText * tbl.y * .6;
  outc += uText * edge * 1.1 + float3(1.) * blade * 1.2 + float3(1.) * flashL * .7 + uText * scar * .45;
  outc *= 1. - .35 * smoothstep(0., .55, uEvtA) * (1. - step(0., tc0)) * uOpt.y;
  outc += (hash(uv * uRes + fract(t) * 91.7) - .5) * (.05) * smoothstep(0., .06, max(outc.r, max(outc.g, outc.b)));
  float cov = (max(m0, inBand)) * boxMask(uv);
  return finish(boxed(outc, uv), cov);
}